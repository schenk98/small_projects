<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://poe.com/notificationsoap"
           xmlns:tns="http://poe.com/notificationsoap"
           elementFormDefault="qualified">

    <xs:element name="SendNotificationRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="kind" type="xs:string"/>
                <xs:element name="toEmail" type="xs:string"/>
                <xs:element name="subject" type="xs:string"/>
                <xs:element name="body" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="SendNotificationResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="accepted" type="xs:boolean"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
