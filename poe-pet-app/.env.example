## Copy to `.env.local` (recommended) and fill in values.
## `.env.local` is ignored by git (see repo root `.gitignore`).
##
## Never commit real secrets.

# MongoDB connection (matches poe-pet-app/docker-compose.yml defaults)
MONGODB_URI=mongodb://admin:admin123@localhost:27017/poe_pet?authSource=admin

# PostgreSQL connection for activity history / achievements / notification prefs
SQL_DATABASE_URL=jdbc:postgresql://localhost:5432/poe_pet
SQL_DATABASE_USERNAME=poe_pet
SQL_DATABASE_PASSWORD=poe_pet

# Mailhog defaults
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
NOTIFICATION_FROM_ADDRESS=no-reply@poe-pet.local

# Optional: skip email verification + verification mail (alpha without SMTP). Default false.
# APP_SKIP_EMAIL_VERIFICATION=true

# Optional: Playwright E2E (see frontend/playwright.config.ts)
# PLAYWRIGHT_BASE_URL=http://localhost:5173
# PLAYWRIGHT_API_URL=http://localhost:8080
# PLAYWRIGHT_MAILHOG_URL=http://localhost:8025
# Optional: privileged verified user for mail-soap.spec.ts (must match APP_PRIVILEGED_EMAILS)
# E2E_SOAP_EMAIL=dev-soap@local.test
# E2E_SOAP_PASSWORD=ChangeMe1

# Persona / AI guardrails (backend)
APP_AI_PERSONA_ADDENDUM=Persona rules: answer in 1-3 short sentences as the pet. Playful and curious. Do not mention being an AI or a language model. No URLs or code blocks.
# APP_AI_CHAT_MAX_USER_MESSAGE_CHARS=1800
# APP_AI_CHAT_MAX_CONVERSATION_TURNS=6
# APP_AI_CHAT_MAX_ASSISTANT_CHARS=3500
# APP_AI_CHAT_MAX_CONTEXT_CHARS=6000

# Backend config
WEB_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=

# Optional: local SLM gateway integration
APP_AI_GATEWAY_BASE_URL=http://localhost:8090
APP_AI_GATEWAY_API_KEY=change-me
# APP_AI_GATEWAY_CONNECT_TIMEOUT_SECONDS=15

# Optional: notification automation + SOAP side-service
APP_NOTIFICATIONS_ENABLED=true
APP_NOTIFICATION_SOAP_ENABLED=true
APP_NOTIFICATION_SOAP_URL=http://localhost:8081/ws
APP_NOTIFICATION_LOW_HUNGER_THRESHOLD=15

# --- Docker Compose only (copy vars you need into a project-root `.env`; compose loads it for interpolation) ---
# If something else already uses host port 8080 (e.g. local Spring), map the container elsewhere:
# BACKEND_HOST_PORT=18080
# Then open the app at http://localhost:5173 — `/api` still proxies to the backend container.
