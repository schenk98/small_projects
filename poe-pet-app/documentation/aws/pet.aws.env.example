# Copy to the pet EC2 as: ~/poe-pet-app/.env.aws
# Used by: docker compose --env-file .env.aws ...
# Do not commit real values.

# Alpha without SMTP: skip inbox verification (register → login immediately). Set false for production.
APP_SKIP_EMAIL_VERIFICATION=true

# Frontend nginx: host port (container listens on 80 inside). Use 80 on EC2 so security group "HTTP 80" matches.
FRONTEND_HOST_PORT=80

# --- Public URLs (use your Elastic IP or domain) ---
WEB_BASE_URL=http://REPLACE_WITH_ELASTIC_IP
API_BASE_URL=http://REPLACE_WITH_ELASTIC_IP
APP_CORS_ALLOWED_ORIGINS=http://REPLACE_WITH_ELASTIC_IP

# Frontend build: leave empty so the browser uses same-origin /api and /auth via nginx proxy
VITE_API_BASE_URL=

# --- AI gateway (private IP of the AI EC2 in the same VPC) ---
APP_AI_GATEWAY_BASE_URL=http://REPLACE_AI_PRIVATE_IP:8090
APP_AI_GATEWAY_API_KEY=REPLACE_WITH_STRONG_SECRET_SAME_AS_AI_GATEWAY
# Optional: raise if health checks time out on slow VPC paths (default 10 in application.yml).
# APP_AI_GATEWAY_CONNECT_TIMEOUT_SECONDS=15

# --- Mongo (must match the two lines below; first boot only — changing later needs a new volume or manual DB user) ---
MONGO_INITDB_ROOT_USERNAME=petmongo
MONGO_INITDB_ROOT_PASSWORD=REPLACE_STRONG_MONGO
MONGODB_URI=mongodb://petmongo:REPLACE_STRONG_MONGO@mongodb:27017/poe_pet?authSource=admin

# --- PostgreSQL (first boot only — match SQL_* below) ---
POSTGRES_DB=poe_pet
POSTGRES_USER=poe_pet
POSTGRES_PASSWORD=REPLACE_STRONG
SQL_DATABASE_URL=jdbc:postgresql://postgres:5432/poe_pet
SQL_DATABASE_USERNAME=poe_pet
SQL_DATABASE_PASSWORD=REPLACE_STRONG

# --- Real SMTP (Amazon SES example placeholders) ---
MAIL_HOST=email-smtp.eu-central-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_SES_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_SES_SMTP_PASSWORD

# --- SOAP sidecar (same mail as backend) ---
NOTIFICATION_FROM_ADDRESS=no-reply@your-verified-domain.example

# --- Notifications (set false if you do not want sweeps yet) ---
APP_NOTIFICATIONS_ENABLED=true
APP_NOTIFICATION_SOAP_ENABLED=true
APP_NOTIFICATION_SOAP_URL=http://notification-soap-service:8081/ws
