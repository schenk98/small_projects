## Copy to `gateway.env.local` (recommended) or `gateway.env` (less recommended).
## `gateway.env.local` is ignored by git via `.gitignore`.
##
## Never commit real secrets.

# API key required by the gateway (caller must send: Authorization: Bearer <key>)
AI_GATEWAY_API_KEY=change-me

# Ollama model to load
OLLAMA_MODEL=phi4-mini

# Safety limits / tuning
AI_OLLAMA_TIMEOUT_MS=120000
AI_MAX_OUTPUT_TOKENS=80
AI_OLLAMA_NUM_CTX=1024
AI_OLLAMA_NUM_BATCH=128
AI_OLLAMA_NUM_THREAD=4
AI_OLLAMA_KEEP_ALIVE=10m

